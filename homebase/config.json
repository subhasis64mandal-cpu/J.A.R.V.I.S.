{
  "home_base_version": "1.3",
  "assistant": {"name": "J.A.R.V.I.S.", "mode": "local-first", "status": "development"},
  "capabilities": {
    "voice": true,
    "ai_brain": true,
    "computer_control": true,
    "web_access": true,
    "browser_navigation": true,
    "browser_automation": false,
    "memory": true,
    "multi_device": false,
    "files": true,
    "system": true
  },
  "safety": {
    "allow_arbitrary_shell": false,
    "allow_arbitrary_python": false,
    "require_confirmation_for_control_tools": true,
    "allowlisted_apps_only": true,
    "allowlisted_sites_only": true,
    "secrets_in_repository": false,
    "workspace_file_access": "read-only-scoped",
    "web_access": "bounded-http-read-only"
  },
  "planned_modules": ["browser_automation", "devices"]
}
