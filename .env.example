# Optional Gemini brain. Leave deterministic for fully local/no-network mode.
JARVIS_BRAIN_PROVIDER=deterministic
# Required only when JARVIS_BRAIN_PROVIDER=gemini.
GEMINI_API_KEY=
# Current Gemini model can be overridden without code changes.
JARVIS_GEMINI_MODEL=gemini-3.8-flash

# Optional n8n bridge. Leave blank to keep the bridge disabled.
JARVIS_N8N_WEBHOOK_URL=
# Optional shared secret expected by your n8n webhook/auth layer.
JARVIS_N8N_WEBHOOK_TOKEN=
# Optional request timeout, clamped by JARVIS to 3-60 seconds.
JARVIS_N8N_TIMEOUT_SECONDS=20
